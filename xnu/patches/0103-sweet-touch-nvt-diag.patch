--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -657,7 +657,24 @@
 	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
 	uint32_t mask = 0;
 
+	static uint8_t last[16];
+	static unsigned changes;
+
 	nvt_read(NVT_EVENT_PAGE, buf, sizeof(buf));
+	/* Log the first bytes whenever they change: that reveals the packet layout. */
+	for (unsigned i = 0; i < sizeof(last); i++) {
+		if (buf[i] != last[i]) {
+			printf("SWEET TOUCH: nvt ev %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    buf[0], buf[1], buf[2], buf[3], buf[4], buf[5], buf[6], buf[7]);
+			for (unsigned j = 0; j < sizeof(last); j++) {
+				last[j] = buf[j];
+			}
+			if ((++changes % 50u) == 0) {
+				printf("SWEET TOUCH: nvt still changing (%u)\n", changes);
+			}
+			break;
+		}
+	}
 	for (unsigned i = 0; i < NVT_MAX_FINGERS && i < TOUCH_MAX; i++) {
 		unsigned pos = 1u + 6u * i;
 		uint8_t id = (uint8_t)(buf[pos] >> 3);
@@ -673,6 +690,9 @@
 		y[i] = (int)(((unsigned)buf[pos + 2] << 4) | (buf[pos + 3] & 0x0fu));
 		mask |= 1u << i;
 	}
+	if (mask != st.active) {
+		printf("SWEET TOUCH: nvt mask=%#x x=%d y=%d\n", mask, x[0], y[0]);
+	}
 	touch_report(mask, x, y);
 	return 0;
 }
