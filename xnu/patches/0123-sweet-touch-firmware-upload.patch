+/* ---- firmware upload ---------------------------------------------------
+ *
+ * Bit-banged write of n bytes: page select, then the offset byte with the
+ * write opcode in bit 7 (CTP_SPI_WRITE applies SPI_WRITE_MASK) followed by the
+ * payload. Missing that bit was what kept the controller's RAM untouched.
+ */
+static void
+bb_write_bytes(uint32_t addr, const unsigned char *d, unsigned n)
+{
+	bb_page(addr);
+	bb_cs(1);
+	(void)bb_xfer((uint8_t)((addr & 0x7fu) | 0x80u));
+	for (unsigned i = 0; i < n; i++) {
+		(void)bb_xfer(d[i]);
+	}
+	bb_cs(0);
+	delay(2);
+}
+
+static uint32_t
+nvt_w32(const unsigned char *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* One ILM/DLM bank: destination, length and golden checksum. */
+static void
+nvt_bld_crc_bank(uint32_t des, uint32_t sram, uint32_t length_addr,
+    uint32_t size, uint32_t gsum, uint32_t crc)
+{
+	uint8_t b[4];
+
+	b[0] = (uint8_t)sram;
+	b[1] = (uint8_t)(sram >> 8);
+	b[2] = (uint8_t)(sram >> 16);
+	bb_write_bytes(des, b, 3);
+
+	b[0] = (uint8_t)size;
+	b[1] = (uint8_t)(size >> 8);
+	b[2] = (uint8_t)((size >> 16) & 1u);
+	bb_write_bytes(length_addr, b, 3);
+
+	b[0] = (uint8_t)crc;
+	b[1] = (uint8_t)(crc >> 8);
+	b[2] = (uint8_t)(crc >> 16);
+	b[3] = (uint8_t)(crc >> 24);
+	bb_write_bytes(gsum, b, 4);
+}
