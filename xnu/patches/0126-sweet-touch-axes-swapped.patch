--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -894,6 +894,7 @@
 		unsigned pos = 1u + 6u * i;
 		uint8_t id = (uint8_t)(buf[pos] >> 3);
 		uint8_t status = (uint8_t)(buf[pos] & 7u);
+		int rx, ry;
 
 		if (id == 0 || id > BB_MAX_FINGERS) {
 			continue;
@@ -901,8 +902,15 @@
 		if (status != 1u && status != 2u && status != 0u) {
 			continue;
 		}
-		x[i] = (int)(((unsigned)buf[pos + 1] << 4) | (buf[pos + 3] >> 4));
-		y[i] = (int)(((unsigned)buf[pos + 2] << 4) | (buf[pos + 3] & 0x0fu));
+		/*
+		 * The chip's first coordinate tracks the screen's vertical axis and
+		 * its second the horizontal one: a horizontal swipe moves the pointer
+		 * vertically unless they are swapped.
+		 */
+		rx = (int)(((unsigned)buf[pos + 1] << 4) | (buf[pos + 3] >> 4));
+		ry = (int)(((unsigned)buf[pos + 2] << 4) | (buf[pos + 3] & 0x0fu));
+		x[i] = ry;
+		y[i] = rx;
 		mask |= 1u << i;
 	}
 	touch_report(mask, x, y);
