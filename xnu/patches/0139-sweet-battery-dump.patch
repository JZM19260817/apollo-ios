--- a/iokit/Kernel/arm/SweetBattery.cpp
+++ b/iokit/Kernel/arm/SweetBattery.cpp
@@ -299,6 +299,37 @@
 			    g_sid, per, type, sub);
 		}
 		IOLog("SWEET BAT: peripheral scan done for sid %u\n", g_sid);
+
+		/*
+		 * The candidates: 0x2c answers with the fuel-gauge type, 0x1d,
+		 * 0x1e and 0x24 with the SMB charger type, 0x3c with the DC
+		 * charger type. Dump their first 32 registers.
+		 */
+		{
+			static const uint8_t cand[5] = {0x1d, 0x1e, 0x24, 0x2c,
+				0x3c};
+
+			for (unsigned c = 0; c < 5; c++) {
+				uint8_t per = cand[c];
+
+				for (unsigned r = 0; r < 0x20; r += 8) {
+					uint8_t b[8] = {0};
+					unsigned got = 0;
+
+					for (unsigned k = 0; k < 8; k++) {
+						if (!sweet_spmi_read(g_sid,
+						    ((unsigned)per << 8) | (r + k),
+						    &b[k])) {
+							got++;
+						}
+					}
+					IOLog("SWEET BAT: per %02x %02x:"
+					    " %02x %02x %02x %02x %02x %02x %02x %02x"
+					    " (%u/8)\n", per, r, b[0], b[1], b[2],
+					    b[3], b[4], b[5], b[6], b[7], got);
+				}
+			}
+		}
 	}
 	/* Publish a complete source BEFORE registerService wakes powerd. */
 	poll();
