--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -957,6 +957,32 @@
 		static unsigned seen;
 		static bool dumped;
 
+		{
+			static int ra_min = 1 << 20, ra_max = -1;
+			static int rb_min = 1 << 20, rb_max = -1;
+			static unsigned rseen;
+
+			for (unsigned i = 0; i < BB_MAX_FINGERS; i++) {
+				unsigned pos = 1u + 6u * i;
+				uint8_t id = (uint8_t)(buf[pos] >> 3);
+				uint8_t status = (uint8_t)(buf[pos] & 7u);
+				int a, b;
+
+				if (id == 0 || id > BB_MAX_FINGERS) { continue; }
+				if (status != 1u && status != 2u) { continue; }
+				a = (int)(((unsigned)buf[pos + 1] << 4) | (buf[pos + 3] >> 4));
+				b = (int)(((unsigned)buf[pos + 2] << 4) | (buf[pos + 3] & 0x0fu));
+				if (a < ra_min) { ra_min = a; }
+				if (a > ra_max) { ra_max = a; }
+				if (b < rb_min) { rb_min = b; }
+				if (b > rb_max) { rb_max = b; }
+			}
+			if ((++rseen % 200u) == 0u) {
+				printf("SWEET TOUCH: rawA %d..%d rawB %d..%d\n",
+				    ra_min, ra_max, rb_min, rb_max);
+			}
+		}
+
 		if (!dumped) {
