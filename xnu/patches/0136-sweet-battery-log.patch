  * The SMB5 charger and the QG live on qcom,pm8150b@2 in apollo's device tree;
  * SID 0 is the plain PM8150 and has none of these registers.
  */
-#define PM8150B_SID 2u
+static unsigned g_sid = 2;	/* boot arg sweetbattery_sid overrides */
 
 class SweetBattery : public IOPMPowerSource {
 	OSDeclareDefaultStructors(SweetBattery);
@@ -175,8 +175,8 @@
 	uint16_t previous = 0;
