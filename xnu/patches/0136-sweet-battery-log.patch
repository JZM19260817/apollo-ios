+	    !sweet_spmi_read(g_sid, 0x4804, &type) && type == 0x0d &&
+	    !sweet_spmi_read(g_sid, 0x4808, &present) && (present & 1u) &&
 	    readWord(0x48c0, &rawVoltage) && rawVoltage != 0x8000 &&
-	    !sweet_spmi_read(PM8150B_SID, 0x1310, &usb) &&
-	    !sweet_spmi_read(PM8150B_SID, 0x110b, &path) &&
-	    !sweet_spmi_read(PM8150B_SID, 0x1006, &charger) &&
-	    !sweet_spmi_read(PM8150B_SID, 0x1007, &error) &&
-	    !sweet_spmi_read(PM8150B_SID, 0x100d, &temperature);
+	    !sweet_spmi_read(g_sid, 0x1310, &usb) &&
+	    !sweet_spmi_read(g_sid, 0x110b, &path) &&
+	    !sweet_spmi_read(g_sid, 0x1006, &charger) &&
