+/* Clock the bus hard with CS high: gives the controller a fast clock to boot. */
+static void
+bb_clock_burst(unsigned pulses)
+{
+	touch_gpio(11, 0, 0, 6, true, true);	/* CS high */
+	for (unsigned i = 0; i < pulses; i++) {
+		touch_gpio(10, 0, 0, 6, true, true);
+		touch_gpio(10, 0, 0, 6, true, false);
+	}
+}
