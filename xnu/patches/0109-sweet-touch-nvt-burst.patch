+/*
+ * Read n bytes from addr in a single SPI transaction: the vendor issues one
+ * spi_transfer holding the address byte followed by zeros, and the received
+ * block starts two bytes in.
+ */
+static int
+nvt_read_burst(uint32_t addr, uint8_t *buf, unsigned n)
+{
+	nvt_page(addr);
+	nvt_cs(1);
+	touch_wr(st.se, 0x26cu, n + 1u);
+	touch_wr(st.se, 0x270u, n + 1u);
+	touch_wr(st.se, 0x600u, SE_SPI_TX_RX_OP << 27);
+	touch_wr(st.se, 0x700u, addr & 0x7fu);
+	for (unsigned i = 0; i < n; i++) {
+		touch_wr(st.se, 0x700u, 0u);
+	}
+	if (se_spi_done(4000)) {
+		nvt_cs(0);
+		return -1;
+	}
+	/* Drop the first two received bytes (address phase and dummy). */
+	(void)touch_rd(st.se, 0x780u);
+	(void)touch_rd(st.se, 0x780u);
+	for (unsigned i = 0; i < n; i++) {
+		buf[i] = (uint8_t)(touch_rd(st.se, 0x780u) & 0xffu);
+	}
+	nvt_cs(0);
+	return 0;
+}
