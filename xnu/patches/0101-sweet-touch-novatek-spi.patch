@@ -743,6 +833,37 @@
 		printf("SWEET TOUCH: L11C RPMh enable failed %d; probes skipped\n", power_error);
 		goto out;
 	}
+	/* apollo drives the panel over SPI; the ICs below speak I2C. */
+	if (((touch_rd(st.se, 0x68) >> 8) & 0xffu) == 1u) {
+		uint8_t fw[17];
+
+		printf("SWEET TOUCH: SE is SPI, bringing up the NT36675\n");
+		touch_gpio(8, 1, 0, 6, false, false);
+		touch_gpio(9, 1, 0, 6, false, false);
+		touch_gpio(10, 1, 0, 6, false, false);
+		touch_gpio(11, 0, 0, 6, true, true);
+		se_spi_setup();
+		nvt_reset();
+		nvt_read(NVT_EVENT_PAGE | NVT_FWINFO_OFF, fw, sizeof(fw));
+		printf("SWEET TOUCH: nvt fw=%02x.%02x geom=%ux%u id=%02x%02x\n",
+		    fw[1], fw[2],
+		    ((unsigned)fw[5] << 8) | fw[6], ((unsigned)fw[7] << 8) | fw[8],
+		    fw[9], fw[10]);
+		if ((uint8_t)(fw[1] + fw[2]) != 0xffu) {
+			printf("SWEET TOUCH: nvt fw info invalid, stopping\n");
+			goto out;
+		}
+		unsigned nvt_ticks = 0;
+		while (!st.dead) {
+			(void)nvt_poll();
+			if ((++nvt_ticks % 600u) == 0) {
+				printf("SWEET TOUCH: nvt alive, active=%#x\n", st.active);
+			}
+			touch_wait(10);
+		}
+		touch_report(0, st.x, st.y);
+		goto out;
+	}
 	touch_gpio(90, 0, 0, 0, true, true); /* board digital power enable */
 	touch_wait(10); /* conservative rail settling; not a DT timing value */
 	touch_gpio(6, 1, 0, 0, false, false); /* qup11 SDA/SCL, 2 mA */
