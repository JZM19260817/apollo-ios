+/* ---- Novatek NT36675 over the SPI transport above --------------------- */
+
+#define NVT_EVENT_PAGE		0x00000u
+#define NVT_FWINFO_OFF		0x78u
+#define NVT_POINT_LEN		65u
+#define NVT_MAX_FINGERS		10u
+
+static vm_offset_t nvt_south;
+
+static void
+nvt_reset(void)
+{
+	uint32_t cfg;
+
+	if (!nvt_south) {
+		nvt_south = ml_io_map(0x0f500000u, 0x10000);
+	}
+	if (!nvt_south) {
+		printf("SWEET TOUCH: south TLMM map failed\n");
+		return;
+	}
+	touch_wr(nvt_south, 38u * 0x1000u + 4u, 2u);	/* latch high */
+	cfg = touch_rd(nvt_south, 38u * 0x1000u);
+	cfg &= ~0x3ffu;
+	cfg |= (8u << 6) | 0x200u;			/* gpio, output, 8 mA */
+	touch_wr(nvt_south, 38u * 0x1000u, cfg);
+	delay(10);
+	touch_wr(nvt_south, 38u * 0x1000u + 4u, 0u);	/* release: low */
+	delay(60);
+}
+
+static void
+nvt_cs(int selected)
+{
+	touch_gpio(11, 0, 0, 6, true, !selected);
+	delay(1);
+}
+
+static void
+nvt_page(uint32_t addr)
+{
+	nvt_cs(1);
+	(void)se_spi_xfer(0xffu);
+	(void)se_spi_xfer((uint8_t)((addr >> 15) & 0xffu));
+	(void)se_spi_xfer((uint8_t)((addr >> 7) & 0xffu));
+	nvt_cs(0);
+}
+
+static void
+nvt_read(uint32_t addr, uint8_t *buf, unsigned len)
+{
+	nvt_page(addr);
+	nvt_cs(1);
+	(void)se_spi_xfer((uint8_t)(addr & 0x7fu));
+	(void)se_spi_xfer(0u);
+	for (unsigned i = 0; i < len; i++) {
+		buf[i] = se_spi_xfer(0u);
+	}
+	nvt_cs(0);
+}
+
+static int
+nvt_poll(void)
+{
+	uint8_t buf[NVT_POINT_LEN];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+
+	nvt_read(NVT_EVENT_PAGE, buf, sizeof(buf));
+	for (unsigned i = 0; i < NVT_MAX_FINGERS && i < TOUCH_MAX; i++) {
+		unsigned pos = 1u + 6u * i;
+		uint8_t id = (uint8_t)(buf[pos] >> 3);
+		uint8_t status = (uint8_t)(buf[pos] & 7u);
+
+		if (id == 0 || id > NVT_MAX_FINGERS) {
+			continue;
+		}
+		if (status != 1u && status != 2u) {
+			continue;
+		}
+		x[i] = (int)(((unsigned)buf[pos + 1] << 4) | (buf[pos + 3] >> 4));
+		y[i] = (int)(((unsigned)buf[pos + 2] << 4) | (buf[pos + 3] & 0x0fu));
+		mask |= 1u << i;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+
 static bool
