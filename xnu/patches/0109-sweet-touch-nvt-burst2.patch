+/* Wait until the SE's TX FIFO has room, then push one word. */
+static void
+se_spi_tx(uint32_t word)
+{
+	for (unsigned i = 0; i < 200u; i++) {
+		if ((touch_rd(st.se, 0x800u) & 0x7fu) == 0u) {
+			break;
+		}
+		delay(1);
+	}
+	touch_wr(st.se, 0x700u, word);
+}
+
+/*
+ * Read n bytes from addr in a single SPI transaction, like the vendor's one
+ * spi_transfer: address byte followed by zeros, data starts two bytes in.
+ */
+static int
+nvt_read_burst(uint32_t addr, uint8_t *buf, unsigned n)
+{
+	unsigned want = n + 1u;
+
+	nvt_page(addr);
+	nvt_cs(1);
+	touch_wr(st.se, 0x26cu, want);
+	touch_wr(st.se, 0x270u, want);
+	touch_wr(st.se, 0x600u, SE_SPI_TX_RX_OP << 27);
+	se_spi_tx(addr & 0x7fu);
+	for (unsigned i = 0; i < n; i++) {
+		se_spi_tx(0u);
+	}
+	if (se_spi_done(4000)) {
+		nvt_cs(0);
+		return -1;
+	}
+	/* Wait for the received words to land, then drop the two dummy bytes. */
+	for (unsigned i = 0; i < 2000u; i++) {
+		if ((touch_rd(st.se, 0x804u) & 0x7fu) >= want) {
+			break;
+		}
+		delay(1);
+	}
+	(void)touch_rd(st.se, 0x780u);
+	(void)touch_rd(st.se, 0x780u);
+	for (unsigned i = 0; i < n; i++) {
+		buf[i] = (uint8_t)(touch_rd(st.se, 0x780u) & 0xffu);
+	}
+	nvt_cs(0);
+	return 0;
+}
