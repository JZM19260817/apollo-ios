+	/*
+	 * 0x17004/0x17008 are the wrapper AHB branches: hardware-controlled, so
+	 * their halt bit stays set even though the SE registers are accessible.
+	 * Only the SE4 clock branch (last entry) must really be un-halted.
+	 */
 	const uint32_t halts[] = {0x17004u, 0x17008u, 0x23000u, 0x174ccu};
 	uint32_t cfg = touch_rd(st.gcc, TOUCH_RCG + 4u);
 
