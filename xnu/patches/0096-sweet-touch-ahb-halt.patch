 	for (unsigned i = 0; i < sizeof(halts) / sizeof(halts[0]); ++i) {
+		bool critical = halts[i] == 0x174ccu;
+
 		if (!touch_wait_clear(st.gcc, halts[i], 1u << 31)) {
-			printf("SWEET TOUCH: branch %#x still halted (%#x)\n", halts[i],
+			printf("SWEET TOUCH: branch %#x %s (%#x)\n", halts[i],
+			    critical ? "still halted" : "halted, not critical",
