--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -906,6 +906,27 @@
 		mask |= 1u << i;
 	}
 	touch_report(mask, x, y);
+
+	/* What range does the controller actually report? */
+	if (mask) {
+		static int min_x = 1 << 20, max_x = -1;
+		static int min_y = 1 << 20, max_y = -1;
+		static unsigned seen;
+
+		for (unsigned i = 0; i < TOUCH_MAX; i++) {
+			if (!(mask & (1u << i))) {
+				continue;
+			}
+			if (x[i] < min_x) { min_x = x[i]; }
+			if (x[i] > max_x) { max_x = x[i]; }
+			if (y[i] < min_y) { min_y = y[i]; }
+			if (y[i] > max_y) { max_y = y[i]; }
+		}
+		if ((++seen % 100u) == 0u) {
+			printf("SWEET TOUCH: raw x %d..%d y %d..%d\n",
+			    min_x, max_x, min_y, max_y);
+		}
+	}
 	return 0;
 }
 
