+/* ---- apollo GENI SPI transport (SE4) ---------------------------------- */
+/* SE4 is already mapped in st.se by 0095 (TOUCH_SE_PA = 0x990000). */
+#define SE_SPI_TX_RX_OP	7u
+#define SE_SPI_CS_ON	8u
+#define SE_SPI_CS_OFF	9u
+#define SE_CMD_DONE	(1u << 0)
+
+static void
+se_spi_wait(unsigned us)
+{
+	delay(us);
+}
+
+static int
+se_spi_done(unsigned us)
+{
+	for (unsigned i = 0; i < us; i++) {
+		uint32_t status = touch_rd(st.se, 0x610u);
+
+		if (status & SE_CMD_DONE) {
+			touch_wr(st.se, 0x618u, status);
+			return 0;
+		}
+		delay(1);
+	}
+	return 1;
+}
+
+static void
+se_spi_cs(int on)
+{
+	touch_wr(st.se, 0x600u, (on ? SE_SPI_CS_ON : SE_SPI_CS_OFF) << 27);
+	(void)se_spi_done(2000);
+}
+
+static uint8_t
+se_spi_xfer(uint8_t out)
+{
+	touch_wr(st.se, 0x26cu, 1u);
+	touch_wr(st.se, 0x270u, 1u);
+	touch_wr(st.se, 0x600u, SE_SPI_TX_RX_OP << 27);
+	touch_wr(st.se, 0x700u, out);
+	if (se_spi_done(2000)) {
+		return 0xff;
+	}
+	return (uint8_t)(touch_rd(st.se, 0x780u) & 0xffu);
+}
+
+static void
+se_spi_setup(void)
+{
+	/* XO to the SE, 9.6 MHz SPI, 8-bit MSB-first words, manual CS. */
+	touch_wr(st.se, 0x20u, 1u);
+	touch_wr(st.se, 0x24u, 0x7fu);
+	touch_wr(st.se, 0xe18u, 0);
+	touch_wr(st.se, 0xe1cu, 0);
+	touch_wr(st.se, 0x258u, touch_rd(st.se, 0x258u) & ~1u);
+	touch_wr(st.se, 0x810u, 8u);
+	touch_wr(st.se, 0x814u, 9u);
+	touch_wr(st.se, 0x260u, 0xffu);
+	touch_wr(st.se, 0x284u, 0xffu);
+	touch_wr(st.se, 0x268u, 4u);
+	touch_wr(st.se, 0x25cu, touch_rd(st.se, 0x25cu) & ~(1u << 1));
+	touch_wr(st.se, 0x224u, 0u);
+	touch_wr(st.se, 0x230u, 0u);
+	touch_wr(st.se, 0x7cu, 0u);
+	touch_wr(st.se, 0x48u, (2u << 4) | 1u);
+	se_spi_wait(500);
+}
+
+/* Novatek framing, same as the vendor driver: page select then read. */
+static void
+se_spi_read(uint32_t addr, uint8_t *buf, unsigned n)
+{
+	se_spi_cs(1);
+	se_spi_xfer(0xffu);
+	se_spi_xfer((uint8_t)((addr >> 15) & 0xffu));
+	se_spi_xfer((uint8_t)((addr >> 7) & 0xffu));
+	se_spi_xfer((uint8_t)(addr & 0x7fu));
+	se_spi_xfer(0x00u);			/* dummy */
+	for (unsigned i = 0; i < n; i++) {
+		buf[i] = se_spi_xfer(0x00u);
+	}
+	se_spi_cs(0);
+}
+
