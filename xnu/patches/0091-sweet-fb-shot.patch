+/*
+ * Coarse screenshot into the persistent console log: a 32x16 grid of RGB
+ * samples. Seeing the panel from the log is the only way to tell a missing
+ * handover from a broken scanout when the device has no USB.
+ */
+static void
+sweet_fb_hex2(char *p, uint32_t v)
+{
+	static const char *h = "0123456789abcdef";
+
+	p[0] = h[(v >> 4) & 0xf];
+	p[1] = h[v & 0xf];
+}
+
+static void
+sweet_fb_shot(uint32_t index)
+{
+	volatile uint32_t *fb = (volatile uint32_t *)fPixels;
+	char line[16 + 2 + 32 * 7 + 4];
+
+	if (fPixels == 0 || fRowBytes == 0)
+		return;
+	for (uint32_t gy = 0; gy < 16; gy++) {
+		char *p = line;
+		const char *t = "SWEET FB: shot ";
+
+		while (*t != 0)
+			*p++ = *t++;
+		*p++ = "0123456789abcdef"[(index >> 4) & 0xf];
+		*p++ = "0123456789abcdef"[index & 0xf];
+		for (uint32_t gx = 0; gx < 32; gx++) {
+			uint32_t x = (gx * fWidth) / 32 + fWidth / 64;
+			uint32_t y = (gy * fHeight) / 16 + fHeight / 32;
+			uint32_t px = fb[(uint64_t)y * (fRowBytes / 4) + x];
+
+			*p++ = ' ';
+			sweet_fb_hex2(p, (px >> 16) & 0xff);
+			p += 2;
+			sweet_fb_hex2(p, (px >> 8) & 0xff);
+			p += 2;
+			sweet_fb_hex2(p, px & 0xff);
+			p += 2;
+		}
+		*p = 0;
+		IOLog("%s\n", line);
+	}
+}
