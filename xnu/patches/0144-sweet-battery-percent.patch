@@ -255,16 +255,29 @@
 		unsigned vraw = ((unsigned)vmsb << 8) | vlsb;
 		unsigned iraw = ((unsigned)imsb << 8) | ilsb;
 
-		IOLog("SWEET BAT: fg %s soc %u vraw %u iraw %u sts %02x\n",
-		    fg ? "read" : "failed", soc, vraw, iraw, fsts);
-		if (fg && soc <= 100) {
